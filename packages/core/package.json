{
	"name": "@featurebase-connect-sdk/core",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"scripts": {
		"generate:types": "openapi-typescript ../../reference/openapi.json -o src/generated/openapi.ts --default-non-nullable false",
		"generate:zod": "openapi-zod-client ../../reference/openapi.json -o src/generated/schemas.ts --export-schemas",
		"generate:operations": "node scripts/generate-operations.mjs",
		"generate:schema-registry": "node scripts/generate-schema-registry.mjs",
		"generate": "pnpm run generate:types && pnpm run generate:zod && pnpm run generate:operations && pnpm run generate:schema-registry",
		"typecheck": "tsc --noEmit",
		"test": "jest"
	},
	"dependencies": {
		"@zodios/core": "^10.9.6",
		"html-to-text": "^9.0.4",
		"marked": "^18.0.14",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/html-to-text": "^9.0.4",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.5",
		"jest": "^29.7.0",
		"openapi-typescript": "^7.5.2",
		"openapi-zod-client": "^1.18.3",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3"
	}
}
