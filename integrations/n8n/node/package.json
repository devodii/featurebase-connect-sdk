{
	"name": "n8n-nodes-featurebase",
	"version": "0.1.0",
	"description": "n8n community node for Featurebase: feedback boards, changelogs, help center, and support conversations.",
	"license": "MIT",
	"homepage": "https://github.com/devodii/featurebase-connect-sdk",
	"keywords": [
		"n8n-community-node-package",
		"featurebase"
	],
	"author": {
		"name": "Emmanuel Odii",
		"email": "emmanuelodii80@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/devodii/featurebase-connect-sdk.git",
		"directory": "integrations/n8n/node"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"clean": "rm -rf dist .tsbuildinfo",
		"dev": "npm run build && n8n-node dev",
		"lint": "n8n-node lint",
		"lintfix": "n8n-node lint --fix",
		"format": "prettier --write .",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/Credentials/FeaturebaseApi.credentials.js"
		],
		"nodes": [
			"dist/Nodes/Featurebase/Featurebase.node.js",
			"dist/Nodes/Featurebase/FeaturebaseTrigger.node.js"
		]
	},
	"devDependencies": {
		"@featurebase-connect-sdk/core": "workspace:*",
		"@n8n/node-cli": "^0.48.4",
		"@types/jest": "^29.5.14",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"fast-glob": "^3.3.3",
		"jest": "^29.7.0",
		"prettier": "^3.8.3",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
