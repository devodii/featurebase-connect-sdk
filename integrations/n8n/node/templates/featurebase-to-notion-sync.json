{
	"name": "Featurebase to Notion sync",
	"nodes": [
		{
			"parameters": {
				"rule": {
					"interval": [{ "field": "hours", "hoursInterval": 6 }]
				}
			},
			"name": "Schedule (every 6h)",
			"type": "n8n-nodes-base.scheduleTrigger",
			"typeVersion": 1.2,
			"position": [260, 300]
		},
		{
			"parameters": {
				"resource": "post",
				"operation": "getMany",
				"returnAll": true,
				"simplify": true
			},
			"name": "Post: Get Many",
			"type": "n8n-nodes-featurebase-connect.featurebase",
			"typeVersion": 1,
			"position": [520, 300],
			"credentials": {
				"featurebaseApi": {
					"id": "1",
					"name": "Featurebase API"
				}
			}
		},
		{
			"parameters": {
				"resource": "databasePage",
				"operation": "getAll",
				"dataSourceId": {
					"__rl": true,
					"mode": "list",
					"value": ""
				},
				"returnAll": false,
				"limit": 1,
				"filterType": "json",
				"filterJson": "={{ JSON.stringify({ property: \"Featurebase Post ID\", rich_text: { equals: $json.id } }) }}",
				"simple": true
			},
			"name": "Notion: Find Existing Page",
			"type": "n8n-nodes-base.notion",
			"typeVersion": 3,
			"alwaysOutputData": true,
			"position": [780, 300],
			"credentials": {
				"notionApi": {
					"id": "3",
					"name": "Notion account"
				}
			}
		},
		{
			"parameters": {
				"conditions": {
					"combinator": "and",
					"options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
					"conditions": [
						{
							"leftValue": "={{ $json.id }}",
							"rightValue": "",
							"operator": { "type": "string", "operation": "notEmpty" }
						}
					]
				}
			},
			"name": "Already in Notion?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [1040, 300]
		},
		{
			"parameters": {
				"pageId": {
					"__rl": true,
					"mode": "id",
					"value": "={{ $json.id }}"
				},
				"propertiesUi": {
					"propertyValues": [
						{ "key": "Status|select", "selectValue": "={{ $('Post: Get Many').item.json.status.name }}" },
						{ "key": "Upvotes|number", "numberValue": "={{ $('Post: Get Many').item.json.upvotes }}" },
						{ "key": "URL|url", "urlValue": "={{ $('Post: Get Many').item.json.postUrl }}" }
					]
				}
			},
			"name": "Notion: Update Page",
			"type": "n8n-nodes-base.notion",
			"typeVersion": 3,
			"position": [1300, 220],
			"credentials": {
				"notionApi": {
					"id": "3",
					"name": "Notion account"
				}
			}
		},
		{
			"parameters": {
				"dataSourceId": {
					"__rl": true,
					"mode": "list",
					"value": ""
				},
				"title": "={{ $('Post: Get Many').item.json.title }}",
				"propertiesUi": {
					"propertyValues": [
						{ "key": "Status|select", "selectValue": "={{ $('Post: Get Many').item.json.status.name }}" },
						{ "key": "Upvotes|number", "numberValue": "={{ $('Post: Get Many').item.json.upvotes }}" },
						{ "key": "URL|url", "urlValue": "={{ $('Post: Get Many').item.json.postUrl }}" },
						{ "key": "Featurebase Post ID|rich_text", "textContent": "={{ $('Post: Get Many').item.json.id }}" }
					]
				}
			},
			"name": "Notion: Create Page",
			"type": "n8n-nodes-base.notion",
			"typeVersion": 3,
			"position": [1300, 400],
			"credentials": {
				"notionApi": {
					"id": "3",
					"name": "Notion account"
				}
			}
		}
	],
	"connections": {
		"Schedule (every 6h)": {
			"main": [[{ "node": "Post: Get Many", "type": "main", "index": 0 }]]
		},
		"Post: Get Many": {
			"main": [[{ "node": "Notion: Find Existing Page", "type": "main", "index": 0 }]]
		},
		"Notion: Find Existing Page": {
			"main": [[{ "node": "Already in Notion?", "type": "main", "index": 0 }]]
		},
		"Already in Notion?": {
			"main": [[{ "node": "Notion: Update Page", "type": "main", "index": 0 }], [{ "node": "Notion: Create Page", "type": "main", "index": 0 }]]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" }
}
