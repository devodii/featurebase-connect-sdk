{
	"name": "Weekly trending digest",
	"nodes": [
		{
			"parameters": {
				"rule": {
					"interval": [{ "field": "cronExpression", "expression": "0 9 * * 1" }]
				}
			},
			"name": "Schedule (Mon 09:00)",
			"type": "n8n-nodes-base.scheduleTrigger",
			"typeVersion": 1.2,
			"position": [260, 300]
		},
		{
			"parameters": {
				"resource": "post",
				"operation": "getMany",
				"sortBy": "trending",
				"sortOrder": "desc",
				"returnAll": false,
				"limit": 10,
				"simplify": true
			},
			"name": "Post: Get Many (Trending)",
			"type": "n8n-nodes-featurebase.featurebase",
			"typeVersion": 1,
			"position": [520, 300],
			"credentials": {
				"featurebaseApi": {
					"id": "1",
					"name": "Featurebase API"
				}
			}
		},
		{
			"parameters": {
				"resource": "workflowHelper",
				"operation": "revenueWeightedScore",
				"source": "single",
				"postId": {
					"__rl": true,
					"mode": "id",
					"value": "={{$json.id}}"
				},
				"divisor": 1000
			},
			"name": "Revenue-Weighted Score",
			"type": "n8n-nodes-featurebase.featurebase",
			"typeVersion": 1,
			"position": [780, 300],
			"credentials": {
				"featurebaseApi": {
					"id": "1",
					"name": "Featurebase API"
				}
			}
		},
		{
			"parameters": {
				"aggregate": "aggregateAllItemFields",
				"options": {}
			},
			"name": "Aggregate",
			"type": "n8n-nodes-base.aggregate",
			"typeVersion": 1,
			"position": [1040, 300]
		},
		{
			"parameters": {
				"jsCode": "const posts = $input.first().json.data ?? $input.first().json;\nconst lines = posts\n  .sort((a, b) => b.arrWeight - a.arrWeight)\n  .map((p, i) => `${i + 1}. ${p.title} - ${p.upvotes} upvotes, $${p.openPipeline} open pipeline`);\nreturn [{ json: { digest: lines.join('\\n') } }];"
			},
			"name": "Format Digest",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [1300, 300]
		},
		{
			"parameters": {
				"select": "channel",
				"channelId": {
					"__rl": true,
					"mode": "list",
					"value": "#product-feedback"
				},
				"text": "=📈 *This week's trending feedback*\n{{$json.digest}}",
				"otherOptions": {}
			},
			"name": "Slack",
			"type": "n8n-nodes-base.slack",
			"typeVersion": 2.2,
			"position": [1560, 300],
			"credentials": {
				"slackApi": {
					"id": "2",
					"name": "Slack account"
				}
			}
		}
	],
	"connections": {
		"Schedule (Mon 09:00)": {
			"main": [[{ "node": "Post: Get Many (Trending)", "type": "main", "index": 0 }]]
		},
		"Post: Get Many (Trending)": {
			"main": [[{ "node": "Revenue-Weighted Score", "type": "main", "index": 0 }]]
		},
		"Revenue-Weighted Score": {
			"main": [[{ "node": "Aggregate", "type": "main", "index": 0 }]]
		},
		"Aggregate": {
			"main": [[{ "node": "Format Digest", "type": "main", "index": 0 }]]
		},
		"Format Digest": {
			"main": [[{ "node": "Slack", "type": "main", "index": 0 }]]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" }
}
