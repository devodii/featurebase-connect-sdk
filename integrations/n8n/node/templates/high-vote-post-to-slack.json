{
	"name": "High-vote post to Slack",
	"nodes": [
		{
			"parameters": {
				"topics": ["post.voted"],
				"derivedEvent": "upvoteThresholdCrossed",
				"upvoteThreshold": 25,
				"output": {}
			},
			"name": "Featurebase Trigger",
			"type": "n8n-nodes-featurebase.featurebaseTrigger",
			"typeVersion": 1,
			"position": [260, 300],
			"webhookId": "high-vote-post-to-slack",
			"credentials": {
				"featurebaseApi": {
					"id": "1",
					"name": "Featurebase API"
				}
			}
		},
		{
			"parameters": {
				"select": "channel",
				"channelId": {
					"__rl": true,
					"mode": "list",
					"value": "#product-feedback"
				},
				"text": "=🔥 *{{$json.title}}* just crossed 25 upvotes!\nBoard: {{$json.boardId}}\nUpvotes: {{$json.upvotes}}\n{{$json.postUrl}}",
				"otherOptions": {}
			},
			"name": "Slack",
			"type": "n8n-nodes-base.slack",
			"typeVersion": 2.2,
			"position": [520, 300],
			"credentials": {
				"slackApi": {
					"id": "2",
					"name": "Slack account"
				}
			}
		}
	],
	"connections": {
		"Featurebase Trigger": {
			"main": [[{ "node": "Slack", "type": "main", "index": 0 }]]
		}
	},
	"active": false,
	"settings": { "executionOrder": "v1" }
}
