root = true

[*]
indent_style = tab
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Prettier always uses spaces for these regardless of useTabs: YAML's spec
# forbids tabs for indentation, and prettier's markdown printer uses spaces
# for list nesting.
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
